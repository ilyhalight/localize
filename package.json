{
  "name": "localize",
  "version": "0.0.1",
  "private": true,
  "description": "A library for quick and easy localization",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "localize"
  ],
  "homepage": "https://github.com/ilyhalight/localize#readme",
  "bugs": {
    "url": "https://github.com/ilyhalight/localize/issues"
  },
  "license": "MIT",
  "author": "Toil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyhalight/localize"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build:bun": "bun run ./scripts/build.ts",
    "build:doc": "typedoc --options .config/typedoc.json --tsconfig tsconfig.build.json",
    "build:all": "bun build:bun && bun build:doc",
    "update:config": "bun run scripts/update-config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix"
  },
  "dependencies": {
    "ts-json-schema-generator": "^2.9.0"
  },
  "devDependencies": {
    "@toil/typebox-genx": "^0.1.0",
    "@types/bun": "latest",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.5.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-include-example": "^3.0.2",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
